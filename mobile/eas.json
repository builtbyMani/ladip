{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.11.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ladip-production.up.railway.app"
      }
    },
    "preview": {
      "node": "22.11.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ladip-production.up.railway.app"
      }
    },
    "production": {
      "node": "22.11.0",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ladip-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
