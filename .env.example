# LADIP Environment Configuration

# openFDA API Key (optional, defaults to public rate limits if empty)
OPENFDA_API_KEY=

# Google Gemini API Key (for LLM pharmacological explanations and OCR extraction)
GEMINI_API_KEY=

# Application Settings
DATA_DIR=data
DATABASE_URL=sqlite:///data/faers.db
LOG_LEVEL=INFO

# Clinical Alert Fatigue Thresholds (Evans' Criteria)
MIN_PRR_THRESHOLD=2.0
MIN_CHI2_THRESHOLD=4.0
MIN_CASE_COUNT=3
MAX_STABILITY_MONTHS_SUPPRESSION=6.0
